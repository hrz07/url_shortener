<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
    <style>
        :root {
            --primary: #4F46E5;
            --primary-hover: #4338CA;
            --bg: #F3F4F6;
            --text-main: #1F2937;
            --surface: #FFFFFF;
        }

        body {
            font-family: system-ui, -apple-system, sans-serif;
            background-color: var(--bg);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            /* Changed from center to allow scrolling */
            min-height: 100vh;
            margin: 0;
            padding: 2rem 0;
        }

        .container {
            background-color: var(--surface);
            padding: 2.5rem;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            width: 100%;
            max-width: 600px;
            /* Made slightly wider to fit the table */
            text-align: center;
        }

        h1 {
            margin-top: 0;
            font-size: 1.8rem;
            color: var(--text-main);
            margin-bottom: 1.5rem;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        input[type="url"] {
            padding: 0.75rem 1rem;
            border: 1px solid #D1D5DB;
            border-radius: 8px;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s;
        }

        input[type="url"]:focus {
            border-color: var(--primary);
        }

        button {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 0.75rem;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        button:hover {
            background-color: var(--primary-hover);
        }

        .result-card {
            margin-top: 2rem;
            padding: 1.5rem;
            background-color: #EEF2FF;
            border: 1px solid #C7D2FE;
            border-radius: 8px;
        }

        .result-card p {
            margin: 0 0 0.5rem 0;
            font-size: 0.9rem;
            color: #4B5563;
        }

        .result-card a {
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--primary);
            text-decoration: none;
            word-break: break-all;
        }

        .result-card a:hover {
            text-decoration: underline;
        }

        /* --- NEW STYLES FOR THE LIST --- */
        .url-list-container {
            margin-top: 3rem;
            text-align: left;
        }

        .url-list-container h2 {
            font-size: 1.2rem;
            border-bottom: 2px solid #E5E7EB;
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

        th,
        td {
            padding: 0.75rem;
            border-bottom: 1px solid #E5E7EB;
            text-align: left;
        }

        th {
            background-color: #F9FAFB;
            font-weight: 600;
        }

        td a {
            color: var(--primary);
            text-decoration: none;
        }

        td a:hover {
            text-decoration: underline;
        }

        .original-url {
            max-width: 250px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    </style>
</head>

<body>

    <div class="container">
        <h1>✂️ URL Shortener</h1>

        <form action="/" method="POST">
            <input type="url" name="redirectUrl" placeholder="Paste your long URL here (https://...)" required />
            <button type="submit">Shorten Link</button>
        </form>

        <% if (locals.shortUrl) { %>
            <div class="result-card">
                <p>Success! Here is your shortened link:</p>
                <a href="<%= shortUrl %>" target="_blank">
                    <%= shortUrl %>
                </a>
            </div>
            <% } %>

                <!-- --- NEW LIST SECTION --- -->
                <% if (locals.shortUrls && shortUrls.length> 0) { %>
                    <div class="url-list-container">
                        <h2>All Shortened Links</h2>
                        <table>
                            <thead>
                                <tr>
                                    <th>Short Link</th>
                                    <th>Original Destination</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Loop through all the shortUrls passed from your controller -->
                                <% shortUrls.forEach(url=> { %>
                                    <tr>
                                        <!-- Adjust the href depending on how you construct the domain -->
                                        <td>
                                            <a href="/<%= url.shortId %>" target="_blank">/<%= url.shortId %></a>
                                        </td>
                                        <td>
                                            <div class="original-url" title="<%= url.redirectUrl %>">
                                                <a href="<%= url.redirectUrl %>" target="_blank">
                                                    <%= url.redirectUrl %>
                                                </a>
                                            </div>
                                        </td>
                                        <td>
                                            <button class="delete-btn" data-id="<%= url.shortId %>">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
    </div>

</body>

<script>
    const deleteButtons = document.querySelectorAll('.delete-btn');

    deleteButtons.forEach(button => {
        button.addEventListener('click', async (e) => {
            const shortId = e.target.getAttribute('data-id');
            if (confirm('Are you sure you want to delete this link?')) {
                try {
                    const response = await fetch(`/${shortId}`, {
                        method: 'DELETE'
                    });

                    const data = await response.json();

                    if (response.ok) {
                        e.target.closest('tr').remove();
                    } else {
                        alert(data.error || 'Failed to delete');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Something went wrong');
                }
            }
        });
    });
</script>

</html>